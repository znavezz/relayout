<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cmd-m</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/cmd-m</string>
        <!-- Uncomment for a custom hotkey:
        <string>--hotkey</string>
        <string>ctrl+alt+m</string>
        -->
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Relaunch after a crash, but stay quit when the user quits from the menu. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
</dict>
</plist>
